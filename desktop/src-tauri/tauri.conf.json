{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DBD Stats Schnelleintrag",
  "version": "1.0.0",
  "identifier": "de.dominikkocsordi.dbdstats",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DBD Stats – Schnelleintrag",
        "url": "https://dbd.dominikkocsordi.de/quick.html",
        "width": 460,
        "height": 900,
        "minWidth": 340,
        "minHeight": 420,
        "resizable": true,
        "alwaysOnTop": true,
        "center": true,
        "visible": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
